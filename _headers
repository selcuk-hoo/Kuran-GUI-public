# Cloudflare Pages bu dosyayı okuyup başlık ekliyor. sw.js ve surum.js
# HER ZAMAN ağdan taze gelmeli — güncelleme denetimi (app.js'teki
# kayit.update() çağrısı) tarayıcının bunları CDN önbelleğinden değil
# doğrudan sunucudan almasına dayanıyor. Aksi hâlde eski bir sürüm
# CDN'de saatlerce/günlerce takılı kalabilir.
/sw.js
  Cache-Control: no-store

/surum.js
  Cache-Control: no-store
