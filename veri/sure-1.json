{"no":1,"ad_ar":"الفاتحة","ad_tr":"Fâtiha","ayetler":[{"a":1,"p":[[1,"بِسْمِ",1],[1,"ٱللَّهِ",2],[1,"ٱلرَّحْمَـٰنِ",3],[1,"ٱلرَّحِيمِ",4]],"m":["Rahman ve Rahim olan Allah'ın adıyla:","Rahman (ve) rahim (olan) Allah'ın adıyla.","Rahmân ve Rahîm olan Allah'ın ismiyle.","Rahman ve Rahîm Allah'ın adıyla..."],"o":{"edilgen":[],"muhatap":[],"kirilim":{},"edat":[1]},"k":[["سمو","ب·اسْم",""],["أله","اللَّه",""],["رحم","ال·رَحْمٰن",""],["رحم","ال·رَحِيم",""]]},{"a":2,"p":[[1,"ٱلْحَمْدُ",1],[1,"لِلَّهِ",2],[1,"رَبِّ",3],[1,"ٱلْعَـٰلَمِينَ",4]],"m":["Hamd, Alemlerin Rabbi Allah'a mahsustur.","Hamd (övme ve övülme), alemlerin Rabbi Allah'a mahsustur.","Hamd o âlemlerin Rabbi,","Hamt, âlemlerin Rabbi Allah'adır."],"o":{"edilgen":[],"muhatap":[],"kirilim":{},"edat":[2]},"k":[["حمد","ال·حَمْد",""],["أله","ل·اللَّه",""],["ربب","رَبّ",""],["علم","ال·عالَم",""]]},{"a":3,"p":[[1,"ٱلرَّحْمَـٰنِ",1],[1,"ٱلرَّحِيمِ",2]],"m":["O Rahman ve Rahim'dir,","O, rahmandır ve rahimdir.","O Rahmân ve Rahim,","Rahman'dır, Rahîm'dir O."],"o":{"edilgen":[],"muhatap":[],"kirilim":{},"edat":[]},"k":[["رحم","ال·رَحْمٰن",""],["رحم","ال·رَحِيم",""]]},{"a":4,"p":[[1,"مَـٰلِكِ",1],[1,"يَوْمِ",2],[1,"ٱلدِّينِ",3]],"m":["Din Gününün sahibidir.","Ceza gününün malikidir.","O, din gününün maliki Allah'ın.","Din gününün Mâlik'i/ sultanıdır O..."],"o":{"edilgen":[],"muhatap":[],"kirilim":{},"edat":[]},"k":[["ملك","مالِك","1"],["يوم","يَوْم",""],["دين","ال·دِين",""]]},{"a":5,"p":[[1,"إِيَّاكَ",1],[1,"نَعْبُدُ",2],[1,"وَإِيَّاكَ",3],[1,"نَسْتَعِينُ",4]],"m":["Ancak Sana kulluk eder ve yalnız Senden yardım dileriz.","(Rabbimiz!) Ancak sana kulluk ederiz ve yalnız senden medet umarız.","Ancak sana ederiz kulluğu, ibadeti ve ancak senden dileriz yardımı, inayeti. (Ya Rab!).","Yalnız sana ibadet ederiz ve yalnız senden yardım dileriz."],"o":{"edilgen":[],"muhatap":[1,3],"kirilim":{"2MS":2},"edat":[]},"k":[["","إِيّا",""],["عبد","عَبَدَ","1"],["","و·إِيّا",""],["عون","اسْتَعِينُ","10"]]},{"a":6,"p":[[1,"ٱهْدِنَا",1],[1,"ٱلصِّرَٰطَ",2],[1,"ٱلْمُسْتَقِيمَ",3]],"m":["Bizi doğru yola eriştir.","Bize doğru yolu göster.","Hidayet eyle bizi doğru yola,","Dosdoğru giden yola ilet bizi..."],"o":{"edilgen":[],"muhatap":[1],"kirilim":{"2MS":1},"edat":[]},"k":[["هدي","هَدَى","1"],["صرط","ال·صِراط",""],["قوم","ال·مُسْتَقِيم","10"]]},{"a":7,"p":[[1,"صِرَٰطَ",1],[1,"ٱلَّذِينَ",2],[1,"أَنْعَمْتَ",3],[1,"عَلَيْهِمْ",4],[1,"غَيْرِ",5],[1,"ٱلْمَغْضُوبِ",6],[1,"عَلَيْهِمْ",7],[1,"وَلَا",8],[1,"ٱلضَّآلِّينَ",9]],"m":["Nimete erdirdiğin kimselerin yoluna; gazaba uğrayanların, ya da sapıtanların yoluna değil.","Kendilerine lütuf ve ikramda bulunduğun kimselerin yolunu; gazaba uğramışların ve sapmışların yolunu değil!","O kendilerine nimet verdiğin mutlu kimselerin yoluna; o gazaba uğramışların ve o sapmışların yoluna değil.","Kendilerine nimet verdiklerinin, üzerlerine gazap dökülmemişlerin, karanlığa/şaşkınlığa saplanmamışların yoluna..."],"o":{"edilgen":[],"muhatap":[3],"kirilim":{"2MS":1},"edat":[]},"k":[["صرط","صِراط",""],["","الَّذِي",""],["نعم","أَنْعَمَ","4"],["","عَلَى",""],["غير","غَيْر",""],["غضب","ال·مَغْضُوب","1"],["","عَلَى",""],["","و·لا",""],["ضلل","ال·ضالّ","1"]]}]}