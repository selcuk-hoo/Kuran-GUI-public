,{"a":38,"p":[[1,"وُجُوهٌ",1],[1,"يَوْمَئِذٍ",2],[1,"مُّسْفِرَةٌ",3]],"m":["O gün bir takım yüzler aydınlıktır, gülmekte ve sevinmektedir.","O gün bir takım yüzler parıl parıl,","Yüzler var ki, o gün parıl parıl,","Yüzler vardır o gün, pırıl pırıl,"],"k":[["وجه","وَجْه",""],["يوم","يَوْم·إِذ",""],["سفر","مُسْفِرَة","4"]],"km":["yüzler (var ki)","o gün","parıl parıl"]},{"a":39,"p":[[1,"ضَاحِكَةٌ",1],[1,"مُّسْتَبْشِرَةٌ",2]],"m":["O gün bir takım yüzler aydınlıktır, gülmekte ve sevinmektedir.","Güler ve sevinir.","Güler, sevinir.","Gülen, müjdelerle parıldayan."],"k":[["ضحك","ضاحِكَة","1"],["بشر","مُسْتَبْشِرَة","10"]],"km":["güleçtir","sevinçlidir"]},{"a":40,"p":[[1,"وَوُجُوهٌ",1],[1,"يَوْمَئِذٍ",2],[1,"عَلَيْهَا",3],[1,"غَبَرَةٌ",4]],"m":["O gün birtakım yüzler de tozlanmış ve onları karanlık bürümüştür.","Yine o gün birtakım yüzleri de keder bürümüş,","Yüzler de var ki, o gün tozlanmış,","Ve yüzler vardır o gün toza-toprağa bulanmış."],"k":[["وجه","و·وَجْه",""],["يوم","يَوْم·إِذ",""],["","عَلَى",""],["غبر","غَبَرَة",""]],"km":["ve yüzler (vardır)","o gün","üzeri","tozlanmış"]},{"a":41,"p":[[1,"تَرْهَقُهَا",1],[1,"قَتَرَةٌ",2]],"m":["O gün birtakım yüzler de tozlanmış ve onları karanlık bürümüştür.","Hüzünden kapkara kesilmiştir.","Onları karanlık bürümüş,","Tozu-toprağı da bir is bürümüştür."],"k":[["رهق","يَرْهَقُ","1"],["قتر","قَتَرَة",""]],"km":["onları bürümüş","karanlık"]},{"a":42,"p":[[1,"أُو۟لَـٰٓئِكَ",1],[1,"هُمُ",2],[1,"ٱلْكَفَرَةُ",3],[1,"ٱلْفَجَرَةُ",4]],"m":["İşte bunlar inkarcı olanlar, Allah'ın buyruğundan çıkanlardır.","İşte bunlar kafirlerdir, günahkarlardır.","İşte onlardır kâfirler, haktan sapanlar.","İşte bunlardır küfre sapanlar, kötülüğe batanlar."],"k":[["","ذا",""],["","",""],["كفر","ال·كافِر",""],["فجر","ال·فُجّار","1"]],"km":["işte","onlar","kafirlerdir","Hak'tan sapanlardır"]}]}