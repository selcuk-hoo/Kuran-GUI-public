{
  // Cloudflare'ın .html uzantısını adresten otomatik kaldırıp
  // yönlendirme yapmasını (html_handling) ve bulunamayan yollar için
  // index.html'e düşmesini (not_found_handling) KAPATIYORUZ — sw.js
  // dosyaları tam olarak "./yardim.html" gibi adreslerle önbelleğe
  // alıp arıyor, örtük yönlendirme bunu bozabiliyor.
  "name": "kuran-gui-public",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": ".",
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
